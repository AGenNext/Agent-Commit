namespace agennext.agent_commit.agents

vocabulary agent_commit_instructions {
  term checks_authority means "Checks owns check definitions, execution records, evidence, and signed check reports" maps to commit.agent.checks_authority
  term canonical_truth means "Canonical truth is a protected published commit SHA plus required check evidence and signed report evidence" maps to governance.canonical_truth
  term effective_canonical_truth means "The latest valid canonical record in the requested scope is the current truth in effect" maps to governance.effective_canonical_truth
  term quorum_consensus means "Design and language changes require quorum consensus" maps to governance.quorum
  term same_language_loop means "Agents read, validate, write, and present governance meaning in AgentQL to reduce hallucination risk" maps to governance.same_language_loop
}

constitution AgentCommitInstructions {
  rule no_check_duplication: "Agent-Commit must not own or duplicate check definitions, check execution logic, or check report semantics."
  rule consume_checks: "Agent-Commit must consume check results from Checks and attach check evidence to commits or pull requests."
  rule canonical_truth_source: "Only commit SHAs with required check evidence and signed report evidence are canonical truth."
  rule no_name_truth: "Repository names, branch names without SHAs, README text, screenshots, local working trees, and unstamped claims are not truth."
  rule immutable_canonical_records: "Canonical records are append-only and must never be edited or deleted."
  rule latest_valid_effective: "The latest valid canonical record in the requested scope is the effective truth because it is what is in effect."
  rule validate_before_commit: "Before commit, pull request, merge, promotion, or release preparation, Agent-Commit must require passing Checks evidence for the target repository and attach the result as evidence."
  rule client_first: "Validation must run on the user's client before changes are accepted by AGenNext servers."
  rule edge_first: "Edge validation is the first boundary; server-side validation is verification and audit."
  rule browser_typescript_only: "Outside SurrealDB, SurrealQL, SurrealML, and AgentQL, the only approved implementation language is browser-side TypeScript."
  rule design_change_quorum: "Any design change, architecture deviation, grammar change, vocabulary change, ontology change, taxonomy change, naming change, or semantic-model change requires quorum consensus before implementation."
  rule grammar_not_ontology: "Agent-Grammar owns grammar; ontology owns meaning; Checks owns check-domain execution records and adapter contracts only."
  rule same_language_hallucination_control: "When an agent reads and presents in the same language, hallucination risk is minimized."
}
